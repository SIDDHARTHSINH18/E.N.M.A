{
  "name": "enma-desktop",
  "version": "0.1.0",
  "description": "ENMA Windows desktop application",
  "main": "main.js",
  "author": "ENMA",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node config.test.js"
  },
  "build": {
    "appId": "com.enma.desktop",
    "productName": "ENMA",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "config.js",
      "probe.js",
      "backendProcess.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "../backend",
        "to": "backend-project/backend",
        "filter": [
          "**/*",
          "!__pycache__/**",
          "!**/__pycache__/**",
          "!data/**"
        ]
      },
      {
        "from": "../requirements.txt",
        "to": "backend-project/requirements.txt"
      },
      {
        "from": "runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
